<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight picks the light or dark variant automatically; night colours come from values-night/colors.xml. -->
    <style name="Theme.Fcitx5SenseVoice.Settings" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/voice_mic_idle</item>
        <item name="colorOnPrimary">@color/voice_on_accent</item>
        <item name="android:windowBackground">@color/voice_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/settings_card_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/voice_mic_idle</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsSectionTitle.First">
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <style name="SettingsItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/voice_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsItemDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/voice_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/settings_spinner_background</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">40dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:drawableTint">@color/voice_icon</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textColor">@color/voice_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsPrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/settings_primary_button</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/voice_on_accent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsSecondaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/settings_secondary_button</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/voice_mic_idle</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsStatusText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:background">@drawable/settings_divider</item>
    </style>
</resources>
