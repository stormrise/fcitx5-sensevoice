<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fcitx5SenseVoice.Settings" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/voice_mic_idle</item>
        <item name="android:navigationBarColor">@color/voice_surface</item>
        <item name="android:statusBarColor">@color/voice_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:textColor">@color/voice_mic_idle</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/voice_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsItemDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/voice_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:backgroundTint">@color/voice_mic_idle</item>
    </style>
</resources>
