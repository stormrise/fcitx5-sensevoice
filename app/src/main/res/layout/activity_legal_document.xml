<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/legal_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/voice_surface"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/legal_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <ImageButton
            android:id="@+id/legal_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigate_back"
            android:padding="12dp"
            android:src="@drawable/ic_navigate_back" />

        <TextView
            android:id="@+id/legal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-medium"
            android:paddingBottom="16dp"
            android:textColor="@color/voice_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/legal_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/voice_text_primary"
            android:textIsSelectable="true"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
