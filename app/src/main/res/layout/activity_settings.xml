<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/voice_surface"
    android:clipToPadding="true"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <ImageButton
            android:id="@+id/settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/navigate_back"
            android:padding="12dp"
            android:src="@drawable/ic_navigate_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-medium"
            android:text="@string/settings_title"
            android:textColor="@color/voice_text_primary"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/settings_description"
            android:textColor="@color/voice_text_secondary"
            android:textSize="15sp" />

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/ui_language"
                    android:src="@drawable/ic_language" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-medium"
                    android:text="@string/ui_language"
                    android:textColor="@color/voice_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/SettingsItemDescription"
                android:text="@string/ui_language_description" />

            <Spinner
                android:id="@+id/ui_language"
                style="@style/SettingsSpinner" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/ui_theme"
                    android:src="@drawable/ic_theme" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-medium"
                    android:text="@string/ui_theme"
                    android:textColor="@color/voice_text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/SettingsItemDescription"
                android:text="@string/ui_theme_description" />

            <Spinner
                android:id="@+id/ui_theme"
                style="@style/SettingsSpinner" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsSectionTitle.First"
                android:text="@string/ime_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ime_status_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/ime_status"
                    style="@style/SettingsStatusText"
                    android:layout_width="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <Button
                android:id="@+id/open_ime_settings"
                style="@style/SettingsPrimaryButton"
                android:text="@string/open_ime_settings" />

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsSectionTitle"
                android:text="@string/permission_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/permission_status_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/permission_status"
                    style="@style/SettingsStatusText"
                    android:layout_width="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <Button
                android:id="@+id/grant_permission"
                style="@style/SettingsPrimaryButton"
                android:text="@string/grant_permission" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsSectionTitle.First"
                android:text="@string/recognition_section" />

            <TextView
                style="@style/SettingsItemTitle"
                android:text="@string/recognition_language" />

            <TextView
                style="@style/SettingsItemDescription"
                android:text="@string/recognition_language_description" />

            <Spinner
                android:id="@+id/recognition_language"
                style="@style/SettingsSpinner" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/use_itn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="48dp"
                android:text="@string/use_itn"
                android:textColor="@color/voice_text_primary"
                android:textSize="16sp" />

            <TextView
                style="@style/SettingsItemDescription"
                android:text="@string/use_itn_description" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout
                android:id="@+id/advanced_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-medium"
                    android:text="@string/advanced_section"
                    android:textColor="@color/voice_text_primary"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/advanced_chevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_expand_more" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/advanced_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SettingsSectionTitle.First"
                    android:text="@string/vad_section" />

                <TextView
                    style="@style/SettingsItemTitle"
                    android:text="@string/vad_sensitivity" />

                <TextView
                    style="@style/SettingsItemDescription"
                    android:text="@string/vad_sensitivity_description" />

                <Spinner
                    android:id="@+id/vad_sensitivity"
                    style="@style/SettingsSpinner" />

                <TextView
                    style="@style/SettingsItemTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/endpoint_silence" />

                <TextView
                    style="@style/SettingsItemDescription"
                    android:text="@string/endpoint_silence_description" />

                <Spinner
                    android:id="@+id/endpoint_silence"
                    style="@style/SettingsSpinner" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/reset_defaults"
            style="@style/SettingsSecondaryButton"
            android:layout_marginTop="16dp"
            app:backgroundTint="@color/voice_control_container"
            android:text="@string/reset_defaults" />

        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsSectionTitle.First"
                android:text="@string/about_section" />

            <TextView
                android:id="@+id/about_version"
                style="@style/SettingsItemTitle"
                android:text="@string/about_version" />

            <TextView
                style="@style/SettingsItemDescription"
                android:text="@string/about_description" />

            <Button
                android:id="@+id/open_github_repository"
                style="@style/SettingsSecondaryButton"
                app:backgroundTint="@color/voice_control_container"
                android:text="@string/open_github_repository" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsCard">

            <TextView
                style="@style/SettingsSectionTitle.First"
                android:text="@string/legal_section" />

            <TextView
                android:id="@+id/open_privacy_policy"
                style="@style/SettingsRow"
                android:text="@string/open_privacy_policy" />

            <TextView
                android:id="@+id/open_third_party_notices"
                style="@style/SettingsRow"
                android:text="@string/open_third_party_notices" />

            <TextView
                android:id="@+id/open_model_attribution"
                style="@style/SettingsRow"
                android:text="@string/open_model_attribution" />

            <TextView
                android:id="@+id/open_onnx_notices"
                style="@style/SettingsRow"
                android:text="@string/open_onnx_notices" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
