<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/voice_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-medium"
            android:text="@string/settings_title"
            android:textColor="@color/voice_text_primary"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_description"
            android:textColor="@color/voice_text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/recognition_section" />

        <TextView
            style="@style/SettingsItemTitle"
            android:text="@string/recognition_language" />

        <TextView
            style="@style/SettingsItemDescription"
            android:text="@string/recognition_language_description" />

        <Spinner
            android:id="@+id/recognition_language"
            style="@style/SettingsSpinner" />

        <Switch
            android:id="@+id/use_itn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/use_itn"
            android:textColor="@color/voice_text_primary"
            android:textSize="16sp" />

        <TextView
            style="@style/SettingsItemDescription"
            android:text="@string/use_itn_description" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/vad_section" />

        <TextView
            style="@style/SettingsItemTitle"
            android:text="@string/vad_sensitivity" />

        <TextView
            style="@style/SettingsItemDescription"
            android:text="@string/vad_sensitivity_description" />

        <Spinner
            android:id="@+id/vad_sensitivity"
            style="@style/SettingsSpinner" />

        <TextView
            style="@style/SettingsItemTitle"
            android:layout_marginTop="24dp"
            android:text="@string/endpoint_silence" />

        <TextView
            style="@style/SettingsItemDescription"
            android:text="@string/endpoint_silence_description" />

        <Spinner
            android:id="@+id/endpoint_silence"
            style="@style/SettingsSpinner" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/permission_section" />

        <TextView
            android:id="@+id/permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/voice_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/grant_permission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/grant_permission" />

        <Button
            android:id="@+id/reset_defaults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/reset_defaults" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/about_section" />

        <TextView
            android:id="@+id/about_version"
            style="@style/SettingsItemTitle"
            android:text="@string/about_version" />

        <TextView
            style="@style/SettingsItemDescription"
            android:text="@string/about_description" />

        <TextView
            style="@style/SettingsItemDescription"
            android:text="@string/about_contact" />

        <TextView
            style="@style/SettingsSectionTitle"
            android:text="@string/legal_section" />

        <Button
            android:id="@+id/open_privacy_policy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_privacy_policy" />

        <Button
            android:id="@+id/open_third_party_notices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_third_party_notices" />

        <Button
            android:id="@+id/open_model_attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_model_attribution" />

        <Button
            android:id="@+id/open_onnx_notices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_onnx_notices" />
    </LinearLayout>
</ScrollView>
